# Скопіюй у .env поруч зі скриптом і заповни значення

# URL проєкту Supabase (Settings → API → Project URL)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Секретний service_role ключ (Settings → API → service_role). НІКОМУ не показуй.
SUPABASE_SERVICE_KEY=YOUR-SERVICE-ROLE-KEY

# Приватний VAPID-ключ (згенерований на кроці 2 README)
VAPID_PRIVATE_KEY=YOUR-VAPID-PRIVATE-KEY

# Контакт власника у форматі mailto:
VAPID_SUBJECT=mailto:you@example.com
